# Antigravity CLI (agy) for Gemini models, plus the analysis toolchain, for running the evals in evals/ under hard
# resource limits. The toolchain lines mirror ./Dockerfile and Dockerfile.evals.codex (same library versions, so
# the Codex and Gemini evals compare models, not environments); keep them in step.
# Build:  docker build -f Dockerfile.evals.gemini -t geoai-master-skills-evals-gemini .
# Run:    evals/run_gemini_docker.sh <workdir>     (the limits are set there, not here)
FROM python:3.12-slim-bookworm

COPY --from=ghcr.io/astral-sh/uv:0.8 /uv /uvx /usr/local/bin/

RUN apt-get update && apt-get install -y --no-install-recommends libexpat1 ca-certificates curl \
 && rm -rf /var/lib/apt/lists/*

# Antigravity CLI (`agy`), the runner behind the Gemini eval. The official installer always fetches the latest
# build and the CLI self-updates, so the build fails when the installed version is not AGY_VERSION: bump it
# on purpose and record it with the results. Installed as root in /usr/local/bin, so the unprivileged user
# cannot self-update it. State and settings live in /home/geo/.gemini (mounted by run_gemini_docker.sh).
ARG AGY_VERSION=1.3.5
# The installer is saved and then run, not piped: it starts `agy install`, which would read the rest of the pipe.
RUN curl -fsSL -o /tmp/agy-install.sh https://antigravity.google/cli/install.sh \
 && bash /tmp/agy-install.sh --dir /usr/local/bin \
 && rm /tmp/agy-install.sh \
 && { test "$(/usr/local/bin/agy --version)" = "${AGY_VERSION}" \
      || { echo "agy is $(/usr/local/bin/agy --version), not ${AGY_VERSION}; pass --build-arg AGY_VERSION=..." >&2; exit 1; }; }

# rasterio is pinned below 1.5: 1.5.x reads GeoTIFFs with libertiff, which gave CRS and nodata None
# (measured 2026-10-14 on the WorldPop rasters in task 11).
RUN uv venv /opt/venv && VIRTUAL_ENV=/opt/venv uv pip install --no-cache \
    'duckdb>=1.5.5' numpy scipy scikit-learn pandas pyarrow statsmodels networkx \
    shapely 'rasterio==1.4.1' esda libpysal pyyaml pytest

# The thread counts are cooperative; the hard limits come from docker run (see run_gemini_docker.sh).
ENV PATH=/opt/venv/bin:$PATH \
    UV_CACHE_DIR=/opt/uv-cache \
    HOME=/home/geo \
    OMP_NUM_THREADS=8 \
    OPENBLAS_NUM_THREADS=8 \
    MKL_NUM_THREADS=8 \
    NUMEXPR_NUM_THREADS=8

# agy runs commands in a login shell, and Debian's /etc/profile resets PATH; put the venv back.
RUN echo 'export PATH=/opt/venv/bin:$PATH' > /etc/profile.d/venv.sh

RUN useradd --uid 1000 --create-home --home-dir /home/geo geo \
 && mkdir -p /opt/uv-cache /work /home/geo/.gemini && chown -R geo /opt/uv-cache /work /home/geo
USER geo
RUN python -c "import duckdb; c = duckdb.connect(); c.sql('install spatial; install httpfs')" \
 && uvx --from 'duckdb>=1.5.5' python -c "import duckdb" \
 && chmod -R a+rwX /opt/uv-cache

WORKDIR /work
CMD ["bash"]
