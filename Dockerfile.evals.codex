# Codex CLI plus the analysis toolchain, for running the evals in evals/ under hard resource limits.
# The toolchain lines mirror ./Dockerfile; keep the two in step when the library list changes.
# Build:  docker build -f Dockerfile.evals.codex -t geoai-skills-evals-codex .
# Run:    evals/run_codex_docker.sh <workdir>     (the limits are set there, not here)
FROM python:3.12-slim-bookworm

# Pinned for reproducibility; override with --build-arg CODEX_VERSION=... and record it with the results.
ARG CODEX_VERSION=0.162.1
ARG TARGETARCH

COPY --from=ghcr.io/astral-sh/uv:0.8 /uv /uvx /usr/local/bin/

RUN apt-get update && apt-get install -y --no-install-recommends libexpat1 ca-certificates curl \
 && rm -rf /var/lib/apt/lists/*

# The Codex release binaries (musl, static), kept apart from the user state in /home/geo/.codex.
# codex-code-mode-host is a separate asset that codex starts to run commands; without it every
# command fails with "No such file or directory".
RUN case "${TARGETARCH:-$(dpkg --print-architecture)}" in \
      amd64) triple=x86_64-unknown-linux-musl ;; \
      arm64) triple=aarch64-unknown-linux-musl ;; \
      *) echo "unsupported arch" >&2; exit 1 ;; \
    esac \
 && curl -fsSL "https://github.com/openai/codex/releases/download/rust-v${CODEX_VERSION}/codex-${triple}.tar.gz" \
    | tar -xz -C /usr/local/bin \
 && mv "/usr/local/bin/codex-${triple}" /usr/local/bin/codex \
 && curl -fsSL "https://github.com/openai/codex/releases/download/rust-v${CODEX_VERSION}/codex-code-mode-host-${triple}.tar.gz" \
    | tar -xz -C /usr/local/bin \
 && mv "/usr/local/bin/codex-code-mode-host-${triple}" /usr/local/bin/codex-code-mode-host \
 && chmod 0755 /usr/local/bin/codex /usr/local/bin/codex-code-mode-host \
 && codex --version

# rasterio is pinned below 1.5: 1.5.x reads GeoTIFFs with libertiff, which gave CRS and nodata None
# (measured 2026-10-14 on the WorldPop rasters in task 11). Dockerfile does not pin it.
RUN uv venv /opt/venv && VIRTUAL_ENV=/opt/venv uv pip install --no-cache \
    'duckdb>=1.5.5' numpy scipy scikit-learn pandas pyarrow statsmodels networkx \
    shapely 'rasterio==1.4.1' esda libpysal pyyaml pytest

# The thread counts are cooperative; the hard limits come from docker run (see run_codex_docker.sh).
ENV PATH=/opt/venv/bin:$PATH \
    UV_CACHE_DIR=/opt/uv-cache \
    HOME=/home/geo \
    OMP_NUM_THREADS=8 \
    OPENBLAS_NUM_THREADS=8 \
    MKL_NUM_THREADS=8 \
    NUMEXPR_NUM_THREADS=8

# Codex runs commands in a login shell, and Debian's /etc/profile resets PATH; put the venv back.
RUN echo 'export PATH=/opt/venv/bin:$PATH' > /etc/profile.d/venv.sh

RUN useradd --uid 1000 --create-home --home-dir /home/geo geo \
 && mkdir -p /opt/uv-cache /work /home/geo/.codex && chown -R geo /opt/uv-cache /work /home/geo
USER geo
RUN python -c "import duckdb; c = duckdb.connect(); c.sql('install spatial; install httpfs')" \
 && uvx --from 'duckdb>=1.5.5' python -c "import duckdb" \
 && chmod -R a+rwX /opt/uv-cache

WORKDIR /work
CMD ["bash"]
