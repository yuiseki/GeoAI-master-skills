---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const reports = (await getCollection('reports')).sort((a, b) => a.id.localeCompare(b.id));
---

<Base description="公共交通、交通事故、クマの出没を、地理空間データで調べた研究記事を公開しています。">
  <section id="reports" class="reports-section">
    <div class="shell">
      <div class="section-heading">
        <h1>公開中の研究</h1>
        <p>各記事から、分析の原本と再現手順を確認できます。</p>
      </div>
      <div class="report-grid">
        {reports.map((report) => (
          <article class="report-card">
            <a class="card-image" href={`/reports/${report.id}/`} aria-label={`${report.data.title}を読む`}><img src={report.data.image} alt={report.data.imageAlt} width={report.data.imageWidth} height={report.data.imageHeight} loading="lazy" /></a>
            <div class="card-body">
              <p class="card-meta"><span>{report.data.topic}</span><span>{report.data.kicker}</span></p>
              <h3><a href={`/reports/${report.id}/`}>{report.data.title}</a></h3>
              <p>{report.data.summary}</p>
              <a class="read-more" href={`/reports/${report.id}/`}>記事を読む</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="method shell">
    <h2>地図から言えることの範囲</h2>
    <p>結果を読むときは、データの時点や粒度、距離の定義、観測されなかったものを確認します。</p>
  </section>
</Base>

<style>
  .reports-section { background: var(--section); padding: 5rem 0 6rem; }
  .section-heading { display: flex; align-items: end; justify-content: space-between; gap: 2rem; margin-bottom: 2.2rem; }
  .section-heading h1, .method h2 { font-family: var(--display-font); font-weight: 600; font-size: clamp(2rem, 3.3vw, 3rem); line-height: 1.45; letter-spacing: -.05em; margin: 0; }
  .reports-section { scroll-margin-top: 1rem; }
  .section-heading > p { max-width: 25rem; color: var(--muted); font-size: .88rem; margin: 0; }
  .report-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2rem; align-items: start; }
  .report-card { overflow: hidden; background: #fff; border: 1px solid var(--line); }
  .card-image { display: block; overflow: hidden; background: #f6f7f3; }
  .card-image img { height: auto; width: 100%; transition: transform .25s ease; }
  .card-image:hover img { transform: scale(1.025); }
  .card-body { padding: 1.5rem 1.7rem 1.8rem; }
  .card-meta { display: flex; gap: .8rem; color: var(--accent); font-size: .75rem; font-weight: 700; margin: 0; }
  .card-meta span + span { color: var(--muted); font-weight: 500; }
  .card-body h3 { font-family: var(--display-font); font-weight: 600; font-size: clamp(1.3rem, 2vw, 1.8rem); line-height: 1.5; letter-spacing: -.04em; margin: .75rem 0; }
  .card-body h3 a { text-decoration: none; }.card-body h3 a:hover { color: var(--green); }
  .card-body > p:not(.card-meta) { color: var(--muted); font-size: .91rem; min-height: 3.3rem; }
  .read-more { display: inline-block; color: var(--green); font-size: .83rem; font-weight: 700; text-underline-offset: .3rem; margin-top: .5rem; }
  .method { display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; padding-block: 6rem 2rem; align-items: center; }
  .method > p { color: var(--muted); font-size: 1rem; line-height: 2.1; }
  @media (max-width: 760px) { .section-heading, .method { display: block; }.section-heading > p { margin-top: 1rem; }.method { padding-block: 4rem 0; }.report-grid { grid-template-columns: 1fr; } }
  @media (max-width: 430px) { .card-body { padding: 1.25rem; } }
  @media (prefers-reduced-motion: reduce) { .card-image img { transition: none; } }
</style>
