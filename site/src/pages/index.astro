---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const reports = (await getCollection('reports')).sort((a, b) => a.id.localeCompare(b.id));
---

<Base title="地図から社会の課題を調べる" description="公共交通とクマの出没を、地理空間データで調べた研究記事を公開しています。">
  <section class="hero shell">
    <div class="hero-copy">
      <h1>地図から、<br />社会の課題を調べる。</h1>
      <p class="hero-lead">公共交通とクマの出没を調べた結果を公開しています。図とともに、分析の条件や限界も読めます。</p>
      <a class="button-link" href="#reports">研究一覧を見る</a>
    </div>
    <figure class="hero-figure">
      <img src="/images/bus-operator-share.png" alt="全国の自治体別に、単一事業者名の停留所圏に住む高齢者の割合を塗り分けた地図" width="960" height="809" fetchpriority="high" />
      <figcaption>全国のバス停記録と高齢者人口を重ねた分析</figcaption>
    </figure>
  </section>

  <section id="reports" class="reports-section">
    <div class="shell">
      <div class="section-heading">
        <h2>公開中の研究</h2>
        <p>各記事から、分析の原本と再現手順を確認できます。</p>
      </div>
      <div class="report-grid">
        {reports.map((report) => (
          <article class="report-card">
            <a class="card-image" href={`/reports/${report.id}/`} aria-label={`${report.data.title}を読む`}><img src={report.data.image} alt={report.data.imageAlt} width={report.data.imageWidth} height={report.data.imageHeight} loading="lazy" /></a>
            <div class="card-body">
              <p class="card-meta"><span>{report.data.topic}</span><span>{report.data.kicker}</span></p>
              <h3><a href={`/reports/${report.id}/`}>{report.data.title}</a></h3>
              <p>{report.data.summary}</p>
              <a class="read-more" href={`/reports/${report.id}/`}>記事を読む</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="method shell">
    <h2>地図から言えることの範囲</h2>
    <p>結果を読むときは、データの時点や粒度、距離の定義、観測されなかったものを確認します。</p>
  </section>
</Base>

<style>
  .hero { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); align-items: center; gap: clamp(2rem, 5vw, 5rem); padding-block: clamp(4rem, 8vw, 8rem); }
  .hero h1 { margin: 0 0 1.5rem; line-height: 1.4; font-size: clamp(2.3rem, 3.5vw, 3.7rem); letter-spacing: -.055em; font-family: var(--display-font); font-weight: 600; }
  .hero-lead { max-width: 30rem; color: var(--muted); font-size: 1.04rem; line-height: 2; margin-bottom: 2rem; }
  .hero-figure { margin: 0; min-width: 0; background: white; border: 1px solid var(--line); padding: .7rem .7rem 0; }
  .hero-figure img { width: 100%; height: auto; }
  .hero-figure figcaption { padding: .65rem .25rem .8rem; border-top: 1px solid var(--line); color: var(--muted); font-size: .77rem; }
  .reports-section { background: var(--section); padding: 5rem 0 6rem; }
  .section-heading { display: flex; align-items: end; justify-content: space-between; gap: 2rem; margin-bottom: 2.2rem; }
  .section-heading h2, .method h2 { font-family: var(--display-font); font-weight: 600; font-size: clamp(2rem, 3.3vw, 3rem); line-height: 1.45; letter-spacing: -.05em; margin: 0; }
  .reports-section { scroll-margin-top: 1rem; }
  .section-heading > p { max-width: 25rem; color: var(--muted); font-size: .88rem; margin: 0; }
  .report-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2rem; }
  .report-card { overflow: hidden; background: #fff; border: 1px solid var(--line); }
  .card-image { display: block; aspect-ratio: 16/9; overflow: hidden; background: #f6f7f3; }
  .card-image img { height: 100%; width: 100%; object-fit: contain; transition: transform .25s ease; }
  .card-image:hover img { transform: scale(1.025); }
  .card-body { padding: 1.5rem 1.7rem 1.8rem; }
  .card-meta { display: flex; gap: .8rem; color: var(--accent); font-size: .75rem; font-weight: 700; margin: 0; }
  .card-meta span + span { color: var(--muted); font-weight: 500; }
  .card-body h3 { font-family: var(--display-font); font-weight: 600; font-size: clamp(1.3rem, 2vw, 1.8rem); line-height: 1.5; letter-spacing: -.04em; margin: .75rem 0; }
  .card-body h3 a { text-decoration: none; }.card-body h3 a:hover { color: var(--green); }
  .card-body > p:not(.card-meta) { color: var(--muted); font-size: .91rem; min-height: 3.3rem; }
  .read-more { display: inline-block; color: var(--green); font-size: .83rem; font-weight: 700; text-underline-offset: .3rem; margin-top: .5rem; }
  .method { display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; padding-block: 6rem 2rem; align-items: center; }
  .method > p { color: var(--muted); font-size: 1rem; line-height: 2.1; }
  @media (max-width: 760px) { .hero { grid-template-columns: 1fr; gap: 2rem; padding-block: 4rem; }.section-heading, .method { display: block; }.section-heading > p { margin-top: 1rem; }.method { padding-block: 4rem 0; }.report-grid { grid-template-columns: 1fr; } }
  @media (max-width: 430px) { .card-body { padding: 1.25rem; } }
  @media (prefers-reduced-motion: reduce) { .card-image img { transition: none; } }
</style>
