---
import path from 'node:path';
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { GITHUB_BLOB, REPO } from '../../lib/datasets.mjs';

export async function getStaticPaths() {
  const datasets = await getCollection('datasets');
  const reports = await getCollection('reports');
  return datasets.map((dataset) => ({
    params: { id: dataset.id },
    props: { dataset, usedBy: reports.filter((report) => report.data.datasets.some((ref) => ref.id === dataset.id)) },
  }));
}

const { dataset, usedBy } = Astro.props;
const { Content } = await render(dataset);
const title = dataset.body?.match(/^# (.+)$/m)?.[1] ?? dataset.data.id;
const cardSource = dataset.filePath ? `${GITHUB_BLOB}${path.relative(REPO, path.resolve(dataset.filePath))}` : undefined;
const isUrl = (value: string) => /^https?:\/\//.test(value);
---

<Base title={title} description={dataset.data.description}>
  <div class="report-shell shell">
    <nav class="breadcrumb" aria-label="パンくずリスト"><a href="/#reports">研究一覧</a></nav>
    <div class="report-layout">
      <article class="prose card-prose"><Content /></article>
      <aside class="sidebar" aria-label="データセットの概要">
        <dl class="facts">
          <dt>データセット</dt>
          <dd><code>{dataset.data.id}</code></dd>
          <dt>配布元</dt>
          <dd>{isUrl(dataset.data.url) ? <a href={dataset.data.url}>{dataset.data.url}</a> : dataset.data.url}</dd>
          <dt>ライセンス</dt>
          <dd>{dataset.data.license}</dd>
          {dataset.data.card_revision && (
            <>
              <dt>カードの版</dt>
              <dd><code>{dataset.data.card_revision.slice(0, 7)}</code></dd>
            </>
          )}
          <dt>使ったレポート</dt>
          <dd>
            <ul>
              {usedBy.map((report) => <li><a href={`/reports/${report.id}/`}>{report.data.title}</a></li>)}
            </ul>
          </dd>
        </dl>
        {cardSource && <a class="card-source" href={cardSource}>カードの原本を読む</a>}
      </aside>
    </div>
  </div>
</Base>

<style>
  .report-shell { padding-top: 2.5rem; }
  .breadcrumb { display: flex; gap: 1rem; color: var(--muted); font-size: .8rem; }.breadcrumb a { text-decoration: none; }.breadcrumb a:hover { color: var(--accent); }
  .report-layout { display: grid; grid-template-columns: minmax(0, 760px) minmax(200px, 280px); gap: min(6vw, 5rem); align-items: start; padding-top: 1.5rem; }
  .prose { min-width: 0; line-height: 2; }
  .prose :global(h1) { font-family: var(--display-font); font-weight: 600; font-size: clamp(2rem, 4vw, 3rem); line-height: 1.4; letter-spacing: -.045em; margin: 1.5rem 0 1.5rem; }
  .prose :global(h2) { font-family: var(--display-font); font-weight: 600; font-size: 1.5rem; line-height: 1.45; letter-spacing: -.04em; margin: 3.5rem 0 1.2rem; padding-left: 1rem; border-left: 3px solid var(--accent); }
  .prose :global(h3) { font-family: var(--display-font); font-weight: 600; font-size: 1.2rem; line-height: 1.5; margin: 2.5rem 0 .8rem; }
  .prose :global(p) { margin: 1.1rem 0; }
  .prose :global(a) { color: var(--accent); text-underline-offset: .25rem; overflow-wrap: anywhere; }
  .prose :global(code) { font-size: .86em; overflow-wrap: anywhere; }
  .prose :global(pre) { overflow-x: auto; padding: 1rem; border: 1px solid var(--line); border-radius: .3rem; font-size: .85rem; line-height: 1.6; }
  .prose :global(table) { display: block; overflow-x: auto; border-collapse: collapse; margin: 1.5rem 0; font-size: .86rem; line-height: 1.7; }
  .prose :global(th), .prose :global(td) { border-bottom: 1px solid var(--line); padding: .55rem .8rem; vertical-align: top; text-align: left; }
  .prose :global(th) { background: var(--section); font-weight: 700; white-space: nowrap; }
  .sidebar { position: sticky; top: 2rem; padding-top: 2rem; border-top: 3px solid var(--accent); }
  .facts { margin: 0; font-size: .83rem; line-height: 1.7; }
  .facts dt { font-weight: 700; margin-top: 1rem; }.facts dt:first-child { margin-top: 0; }
  .facts dd { margin: .2rem 0 0; color: var(--muted); overflow-wrap: anywhere; }
  .facts ul { margin: 0; padding-left: 1.1rem; }
  .facts a, .card-source { color: var(--accent); text-underline-offset: .25rem; }
  .card-source { display: inline-block; margin-top: 1.5rem; font-size: .82rem; font-weight: 700; }
  @media (max-width: 820px) { .report-layout { display: flex; flex-direction: column; gap: 2rem; }.sidebar { position: static; width: 100%; } }
</style>
