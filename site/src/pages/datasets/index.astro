---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const reports = await getCollection('reports');
const datasets = (await getCollection('datasets'))
  .map((dataset) => ({
    dataset,
    title: dataset.body?.match(/^# (.+)$/m)?.[1] ?? dataset.data.id,
    usedBy: reports.filter((report) => report.data.datasets.some((ref) => ref.id === dataset.id)),
  }))
  // Datasets that more reports lean on come first.
  .sort((a, b) => b.usedBy.length - a.usedBy.length || a.dataset.id.localeCompare(b.dataset.id));
---

<Base title="使ったデータセット" description="公開した調査レポートで実際に使ったデータセットのデータカード" ogImage="/ogp/datasets.png">
  <section class="datasets-section">
    <div class="shell">
      <div class="section-heading">
        <h1>使ったデータセット</h1>
        <p>公開した調査レポートで実際に使ったデータです。各カードから、ライセンス、読み方、気をつけることを確認できます。</p>
      </div>
      <div class="dataset-grid">
        {datasets.map(({ dataset, title, usedBy }) => (
          <article class="dataset-card">
            <h2><a href={`/datasets/${dataset.id}/`}>{title}</a></h2>
            <p class="dataset-id"><code>{dataset.data.id}</code></p>
            <p class="description">{dataset.data.description}</p>
            <dl>
              <dt>ライセンス</dt>
              <dd>{dataset.data.license}</dd>
              <dt>使ったレポート ({usedBy.length})</dt>
              <dd>
                <ul>
                  {usedBy.map((report) => <li><a href={`/reports/${report.id}/`}>{report.data.title}</a></li>)}
                </ul>
              </dd>
            </dl>
          </article>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .datasets-section { background: var(--section); padding: 5rem 0 6rem; }
  .section-heading { display: flex; align-items: end; justify-content: space-between; gap: 2rem; margin-bottom: 2.2rem; }
  .section-heading h1 { font-family: var(--display-font); font-weight: 600; font-size: clamp(2rem, 3.3vw, 3rem); line-height: 1.45; letter-spacing: -.05em; margin: 0; }
  .section-heading > p { max-width: 28rem; color: var(--muted); font-size: .88rem; margin: 0; }
  .dataset-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr)); gap: 1.5rem; align-items: start; }
  .dataset-card { background: #fff; border: 1px solid var(--line); border-top: 3px solid var(--accent); padding: 1.4rem 1.5rem 1.5rem; min-width: 0; }
  .dataset-card h2 { font-family: var(--display-font); font-weight: 600; font-size: 1.15rem; line-height: 1.5; letter-spacing: -.03em; margin: 0; }
  .dataset-card h2 a { text-decoration: none; }.dataset-card h2 a:hover { color: var(--accent); text-decoration: underline; }
  .dataset-id { margin: .4rem 0 0; font-size: .75rem; color: var(--muted); overflow-wrap: anywhere; }
  .description { color: var(--muted); font-size: .85rem; line-height: 1.75; margin: .9rem 0 0; display: -webkit-box; -webkit-line-clamp: 4; -webkit-box-orient: vertical; overflow: hidden; }
  dl { margin: 1rem 0 0; font-size: .8rem; line-height: 1.65; }
  dt { font-weight: 700; margin-top: .7rem; }
  dd { margin: .15rem 0 0; color: var(--muted); overflow-wrap: anywhere; }
  dd:first-of-type { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  dd ul { margin: 0; padding-left: 1.1rem; }
  dd a { color: var(--accent); text-underline-offset: .2rem; }
  @media (max-width: 760px) { .section-heading { display: block; }.section-heading > p { margin-top: 1rem; } }
</style>
