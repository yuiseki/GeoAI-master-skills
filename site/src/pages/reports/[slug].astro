---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import 'katex/dist/katex.min.css';

export async function getStaticPaths() {
  const reports = await getCollection('reports');
  return reports.map((report) => ({ params: { slug: report.id }, props: { report } }));
}

const { report } = Astro.props;
const { Content } = await render(report);
---

<Base title={report.data.title} description={report.data.summary} ogImage={`/ogp/${report.id}.png`}>
  <div class="report-shell shell">
    <nav class="breadcrumb" aria-label="パンくずリスト"><a href="/#reports">研究一覧</a><span>{report.data.topic}</span></nav>
    <header class="report-header">
      <p class="report-meta"><span>{report.data.topic}</span><span>{report.data.kicker}</span></p>
      <h1>{report.data.title}</h1>
      <p class="lede">{report.data.summary}</p>
    </header>
    <div class="report-layout">
      <article class="prose"><Content /></article>
      <aside class="sidebar" aria-label="研究の出典">
        <div class="aside-box">
          <p class="aside-title">分析の原本</p>
          <p>条件、全図、分析コードを確認できます。</p>
          <a href={report.data.source}>元の報告を読む</a>
        </div>
      </aside>
    </div>
    <a class="back-link" href="/#reports">研究一覧に戻る</a>
  </div>
</Base>

<style>
  .report-shell { padding-top: 2.5rem; }
  .breadcrumb { display: flex; gap: 1rem; color: var(--muted); font-size: .8rem; }.breadcrumb span { border-left: 1px solid var(--line); padding-left: 1rem; }.breadcrumb a { text-decoration: none; }.breadcrumb a:hover { color: var(--green); }
  .report-header { max-width: 840px; padding: 4.5rem 0 3.5rem; }
  .report-header h1 { font-family: var(--display-font); font-weight: 600; font-size: clamp(2.5rem, 5vw, 4.5rem); line-height: 1.38; letter-spacing: -.055em; margin: 1rem 0 1.2rem; }
  .report-meta { display: flex; flex-wrap: wrap; gap: 1rem; color: var(--accent); font-size: .8rem; font-weight: 700; }
  .lede { color: var(--muted); font-size: clamp(1rem, 1.55vw, 1.2rem); line-height: 1.9; }
  .report-layout { display: grid; grid-template-columns: minmax(0, 760px) minmax(180px, 250px); gap: min(6vw, 5rem); align-items: start; border-top: 1px solid var(--line); padding-top: 1.5rem; }
  .prose { min-width: 0; line-height: 2; }
  .prose :global(h2) { font-family: var(--display-font); font-weight: 600; font-size: 1.5rem; line-height: 1.45; letter-spacing: -.04em; margin: 3.5rem 0 1.2rem; padding-left: 1rem; border-left: 3px solid var(--green); }
  .prose :global(h2[id]) { scroll-margin-top: 1rem; }
  .prose :global(p) { margin: 1.1rem 0; }
  .prose :global(h3) { font-family: var(--display-font); font-weight: 600; font-size: 1.2rem; line-height: 1.5; margin: 2.5rem 0 .8rem; }
  .prose :global(table) { display: block; overflow-x: auto; border-collapse: collapse; margin: 1.5rem 0; font-size: .86rem; line-height: 1.7; }
  .prose :global(th), .prose :global(td) { border-bottom: 1px solid var(--line); padding: .55rem .8rem; vertical-align: top; text-align: left; }
  .prose :global(th) { background: var(--section); font-weight: 700; white-space: nowrap; }
  .prose :global(td[align="right"]), .prose :global(th[align="right"]) { text-align: right; white-space: nowrap; }
  .prose :global(a) { color: var(--green); text-underline-offset: .25rem; }
  .prose :global(img) { border: 1px solid var(--line); border-radius: .3rem; background: white; margin: 2rem 0; width: 100%; height: auto; }
  .prose :global(.mermaid) { overflow-x: auto; background: white; border: 1px solid var(--line); border-radius: .3rem; padding: 1rem; }
  .prose :global(.katex-display) { overflow-x: auto; overflow-y: hidden; padding: 1rem 0; }
  .sidebar { position: sticky; top: 2rem; padding-top: 2rem; }.aside-box { border-top: 3px solid var(--green); padding: 1.2rem 0; }.aside-title { font-weight: 700; margin: 0; }.aside-box p:not(.aside-title) { color: var(--muted); font-size: .83rem; }.aside-box a { color: var(--green); font-size: .82rem; font-weight: 700; text-underline-offset: .25rem; }
  .back-link { display: inline-block; color: var(--green); font-weight: 700; text-decoration: none; margin-top: 4rem; }.back-link:hover { text-decoration: underline; }
  @media (max-width: 820px) { .report-layout { display: flex; flex-direction: column; gap: 2rem; }.sidebar { position: static; width: 100%; padding-top: 0; }.report-header { padding: 3rem 0 2rem; } }
</style>
