rr < side and 0 <= cc < side:\n                    W[r * side + c, rr * side + cc] = 1\n    return W / W.sum(1, keepdims=True)\n\n\ndef _row_standardise(B):\n    s = B.sum(1, keepdims=True)\n    return np.divide(B, s, out=np.zeros_like(B), where=s > 0)\n\n\ndef lm_tests(y, X, W):\n    y, X = np.asarray(y, float), np.asarray(X, float)\n    n = len(y)\n    b = np.linalg.lstsq(X, y, rcond=None)[0]\n    e = y - X @ b\n    s2 = e @ e / n\n    T = np.trace(W.T @ W + W @ W)\n    WXb = W @ (X @ b)\n    M_WXb = WXb - X @ np.linalg.lstsq(X, WXb, rcond=None)[0]\n    D = (WXb @ M_WXb + T * s2) / s2\n    d_lag, d_err = e @ (W @ y) / s2, e @ (W @ e) / s2\n    stat = {\"lm_lag\": d_lag ** 2 / D, \"lm_error\": d_err ** 2 / T,\n            \"rlm_lag\": (d_lag - d_err) ** 2 / (D - T), \"rlm_error\": (d_err - T / D * d_lag) ** 2 / (T * (1 - T / D))}\n    return {k: (float(v), float(stats.chi2.sf(v, 1))) for k, v in stat.items()}\n\n\ndef _bounds(W):\n    lam = np.linalg.eigvals(W).real\n    return lam, (1 / lam.min() + 1e-6, 1 - 1e-6)\n\n\ndef ml_lag(y, X, W):\n    y, X = np.asarray(y, float), np.asarray(X, float)\n    n = len(y)\n    if n > MAX_UNITS:\n        raise SystemExit(f\"{n} units; this script holds W dense, up to {MAX_UNITS}\")\n    lam, bounds = _bounds(W)\n    Wy = W @ y\n    XtX_inv_Xt = np.linalg.pinv(X)\n\n    def negll(rho):\n        Ay = y - rho * Wy\n=====\n96:def main():\n98:    p.add_argument(\"predictions\")\n99:    p.add_argument(\"table\")\n100:    p.add_argument(\"id\")\n101:    p.add_argument(\"column\")\n102:    p.add_argument(\"--model\")\n103:    p.add_argument(\"--bins\", type=int, default=5)\n104:    p.add_argument(\"--weight\")\n105:    p.add_argument(\"--lon\")\n106:    p.add_argument(\"--lat\")\n107:    p.add_argument(\"--k\", type=int, default=6)"}]},"parent_tool_use_id":null,"session_id":"69fcbe6e-6a9e-4b96-a097-2787b95683e3","uuid":"99d196ec-5e51-47c1-ac14-b95cafd205e8","timestamp":"2026-11-16T08:11:06.844Z","isSynthetic":false,"tool_use_result":{"