# Copy to .env (git-ignored) for evals/run_gemini_docker.sh. Only these two names are read from it,
# and only by name: the value is passed to the container with `docker run -e NAME`, never written to
# the image, to /work, or to the command line.
# Either one is enough; GEMINI_API_KEY wins when both are set. The shell environment is used when .env has neither.
GEMINI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
